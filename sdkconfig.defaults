# Optimize for performance instead of size
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=n

# Reduce bootloader size
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL=0

# Reduce logging level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0 is not set
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set
CONFIG_LINK_TASK_AFFINITY_NO_AFFINITY=y

# HTTP Server Configuration for Provisioning
CONFIG_HTTPD_MAX_REQ_HDR_LEN=32768
CONFIG_HTTPD_MAX_URI_LEN=8192

# Partition Table Configuration
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_large.csv"

# Flash Size Configuration (4MB for ESP32)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# LWIP socket pool. Default (10) is exhausted by the app's own UDP sockets (Link relay,
# LCLK/TTMP broadcast, tempo listener, discovery forward) leaving too few for Ableton
# Link's per-interface discovery gateway, which then fails to open with EMFILE ("Too
# many open files") and never broadcasts -> peers never discover each other. Raise to
# the ESP32 maximum so Link's gateway sockets always open.
CONFIG_LWIP_MAX_SOCKETS=16
